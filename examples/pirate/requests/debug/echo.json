{
  "name": "Echo what the server received",
  "method": "POST",
  "path": "/_debug/echo",
  "body": {
    "name": "${shipName}",
    "limit": "${limit}",
    "typed": 42,
    "flag": "${random.bool}"
  },
  "outputs": {
    "echoMethod": "response.body.method",
    "echoBody": "response.body.body"
  }
}
